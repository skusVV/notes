# Copy to .env for local runs. .env is git-ignored and never deployed.
# In GCP these same names are injected from Secret Manager (see cloudbuild.yaml).

# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Any random string of A-Z a-z 0-9 _ - that you also pass as secret_token when registering the
# webhook. Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string

# Comma-separated Telegram user ids allowed to use the bot. Anyone else gets a refusal message.
# Leave empty or omit to allow everyone. Message the bot to see your own id in the logs.
ALLOWED_USERS=111111111,222222222

# Local dev only
PORT=8080
