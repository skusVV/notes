# Copy to .env for local runs. .env is git-ignored and never deployed.
# In GCP these same names are injected from Secret Manager (see cloudbuild.yaml).

# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Any random string of A-Z a-z 0-9 _ - that you also pass as secret_token when registering the
# webhook. Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string

# Comma-separated Telegram user ids allowed to use the bot. Anyone else gets a refusal message.
# Leave empty or omit to allow everyone. Message the bot to see your own id in the logs.
ALLOWED_USERS=111111111,222222222

# GCP project used for Vertex AI transcription. No API key is involved: the deployed function
# authenticates as its own service account. Unset means voice messages are refused politely and
# text echo keeps working. In GCP this is set automatically by cloudbuild.yaml.
GCP_PROJECT=your-gcp-project-id

# To transcribe voice messages LOCALLY you also need credentials, since your laptop has no GCP
# identity. Download a service-account JSON key in the Console (IAM & Admin -> Service Accounts ->
# Keys -> Add key -> JSON) and point this at it. Keep that file out of git - it is a real
# credential. Leave this unset if you only test voice against the deployed bot.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional. Vertex endpoint. 'global' is ~10% cheaper than a pinned region.
VERTEX_LOCATION=global

# Optional. Model used for transcription. Env-driven so a model rename does not need a code change.
TRANSCRIPTION_MODEL=gemini-3.5-flash-lite

# Optional. Model used to classify each message into note/reminder/symptom/question/...
CLASSIFIER_MODEL=gemini-3.5-flash-lite

# IANA timezone used to turn "tomorrow at 9" into a real instant. The code default is UTC, which
# would resolve relative times to the wrong hour, so this is set explicitly. An invalid name is
# rejected at startup with a warning and falls back to UTC. Becomes per-user once entries are
# stored; until then it is one global setting.
DEFAULT_TIMEZONE=Europe/Kyiv

# Optional. Voice messages longer than this are refused without being downloaded. Default 300.
MAX_VOICE_SECONDS=300

# Firestore database id reminders are stored in. Code default "(default)". In GCP cloudbuild.yaml
# sets this to "(default)" in production and "test" on the test function, so the test lane never
# touches production data. Unset GCP_PROJECT means Firestore is unavailable and reminders are not
# stored (text handling still works).
FIRESTORE_DATABASE=(default)

# Local dev only
PORT=8080

# --- Spec pipeline: read by the spec-verifier, NOT by the bot ---
# The deployed test function and its webhook secret, so the verifier can POST test updates and read
# back the reflected replies (see docs/specs/README.md). TEST_WEBHOOK_SECRET must equal the Secret
# Manager value of TELEGRAM_WEBHOOK_SECRET_TEST that telegram-echo-bot-test runs with, or the
# verifier's POSTs get 401.
TEST_URL=https://telegram-echo-bot-test-xxxxxxxxxx-ew.a.run.app
TEST_WEBHOOK_SECRET=match_the_TELEGRAM_WEBHOOK_SECRET_TEST_value
